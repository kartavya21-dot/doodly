# Database Connection String
# For PostgreSQL (Staging/Production): postgresql://<user>:<password>@<host>:<port>/<dbname>
# For local SQLite development (default): leave empty or unset
DATABASE_URL=postgresql://username:password@localhost:5432/doodly_db

# JWT signing secret key
JWT_SECRET_KEY=your_super_secret_jwt_signing_key_change_me
